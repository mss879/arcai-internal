# ============================================================
#  ARC AI MANAGEMENT — Environment variables
#  Copy this file to `.env.local` and fill in the values.
#  (.env.local is git-ignored — never commit real keys.)
# ============================================================

# ---- Supabase -------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon / publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role / secret key — SERVER ONLY. Used to create users
# when an invite is accepted, allocate commissions, etc.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (transactional email) -----------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. "ARC AI <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=

# ---- OpenAI (Arc voice assistant) -----------------------------
# Powers the floating voice assistant: speech-to-text, the chat +
# tool-calling brain, and text-to-speech. SERVER ONLY — never exposed
# to the browser. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional overrides (sensible defaults are used if left blank):
#   OPENAI_CHAT_MODEL        default: gpt-4o-mini  (try gpt-4o for sharper answers)
#   OPENAI_TRANSCRIBE_MODEL  default: whisper-1
#   OPENAI_TTS_MODEL         default: tts-1        (tts-1-hd = higher quality)
#   OPENAI_TTS_VOICE         default: alloy        (alloy|echo|fable|onyx|nova|shimmer)
#   OPENAI_BASE_URL          default: https://api.openai.com/v1
OPENAI_CHAT_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
# Optional: the proposal writer. This one composes the whole document — it
# chooses the sections, in the order it wants them, for the exact combination
# of packages being sold — so it does NOT ride on the cheap chat default. It
# is the document a client says yes or no to; the model is worth the money.
#   OPENAI_PROPOSAL_MODEL             default: gpt-5.5
#                                     (cheaper: gpt-5.4-mini; classic: gpt-4o)
#                                     If the name isn't enabled on your key the
#                                     app logs a warning and falls back to
#                                     OPENAI_CHAT_MODEL rather than failing.
#   OPENAI_PROPOSAL_REASONING_EFFORT  default: high  (minimal|low|medium|high|xhigh)
#                                     only applies to reasoning models
#   OPENAI_PROPOSAL_TIMEOUT_MS        default: 180000 (3 min). Your host's own
#                                     function timeout still applies first.
OPENAI_PROPOSAL_MODEL=
OPENAI_PROPOSAL_REASONING_EFFORT=
OPENAI_PROPOSAL_TIMEOUT_MS=
# Optional: the CRM prospect-research briefing writer. Defaults to a GPT-5-family
# reasoning model (quality over speed) since it reads a whole site + writes a
# dossier. In production this runs in a Netlify Background Function (15-min
# budget), so the model can think as long as it needs.
#   OPENAI_RESEARCH_MODEL             default: gpt-5.4-mini
#                                     (sharper: gpt-5.5; classic: gpt-4o)
#   OPENAI_RESEARCH_REASONING_EFFORT  default: high  (minimal|low|medium|high|xhigh)
#                                     only applies to reasoning models
#   OPENAI_RESEARCH_TIMEOUT_MS        default: 600000 (10 min). The background
#                                     worker has its own 12-min cap; local dev
#                                     synthesizes inline with no host limit.
OPENAI_RESEARCH_MODEL=
OPENAI_RESEARCH_REASONING_EFFORT=
OPENAI_RESEARCH_TIMEOUT_MS=

# ---- Firecrawl (CRM prospect research) ------------------------
# Powers CRM → Prospect research: when a lead names a company, the
# app searches LinkedIn, the web and recent news through Firecrawl,
# then OpenAI condenses it into a call-ready briefing (competitors,
# pain points, talking points). SERVER ONLY — never exposed to the
# browser. Get a key at https://www.firecrawl.dev/app/api-keys
# Without it, research falls back to a basic report from the lead's
# own fields; pair it with OPENAI_API_KEY for full AI briefings.
FIRECRAWL_API_KEY=
# Optional override (sensible default used if left blank):
#   FIRECRAWL_BASE_URL       default: https://api.firecrawl.dev/v2
FIRECRAWL_BASE_URL=

# ---- Google PageSpeed (CRM website audit) ---------------------
# Powers the research "website scorecard" (mobile Lighthouse: speed,
# SEO, accessibility, best-practices). STRONGLY RECOMMENDED: keyless
# PageSpeed is rate-limited and often fails, and when it does the audit
# can only measure hygiene (HTTPS, viewport) — so it's marked "Limited"
# and its score is capped rather than showing a misleadingly high number.
# A free key makes the audit reliable + complete.
# Get one at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ---- Google Places (Find Leads prospecting) -------------------
# Powers the CRM's "Find Leads" scans: enumerates real businesses in a
# chosen city with authoritative website presence — the only reliable way
# to find businesses with NO website (they're invisible to web search).
# Enable "Places API (New)" on the same Google Cloud project as the
# PageSpeed key, then paste the key here. A full 40-business scan costs
# roughly $0.50 in Places requests. Without it, scans degrade to
# bad-website discovery only (via Firecrawl web search).
GOOGLE_PLACES_API_KEY=
# Optional: model for cold-outreach drafting (default gpt-5.4-mini).
OPENAI_PROSPECTING_MODEL=

# ---- Gemini (Content Studio image generation) -----------------
# Powers Content Studio: generates on-brand images with Gemini 3.1
# Flash Image ("Nano Banana 2"). SERVER ONLY — never exposed to the
# browser. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides (sensible defaults used if left blank):
#   GEMINI_IMAGE_MODEL  default: gemini-3.1-flash-image-preview
#                       (switch to gemini-3.1-flash-image at GA, or
#                        gemini-3-pro-image-preview for the premium tier)
#   GEMINI_BASE_URL     default: https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=
GEMINI_BASE_URL=

# ---- Notify.lk (SMS) ------------------------------------------
# Powers the SMS page: custom messages, payment reminders and
# automation workflows. SERVER ONLY — never exposed to the browser.
# Find both values on https://app.notify.lk under Settings → API.
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
# Your approved Sender ID (case sensitive). Leave blank to use the
# shared "NotifyDEMO" id while testing.
NOTIFYLK_SENDER_ID=
# Optional: protects /api/sms/automation/tick (the cron endpoint that
# fires automation timers when nobody has the app open). If set, the
# cron request must send it as ?secret=... or an Authorization bearer.
SMS_CRON_SECRET=

# ---- WhatsApp Business (Meta Cloud API) -----------------------
# Powers the WhatsApp page: the shared inbox, the AI sales agent,
# keyword automations and the automation engine's "Send WhatsApp"
# step. SERVER ONLY — never exposed to the browser.
#
# Setup (one time, ~15 min):
#   1. developers.facebook.com → Create App → add the "WhatsApp" product.
#   2. Connect your WhatsApp Business number (or start with the test number).
#   3. Business Settings → System Users → generate a PERMANENT access token
#      with whatsapp_business_messaging + whatsapp_business_management.
#   4. WhatsApp → API Setup: copy the "Phone number ID" (NOT the number).
#   5. WhatsApp → Configuration → Webhook:
#        Callback URL : https://<your-domain>/api/whatsapp/webhook
#        Verify token : the WHATSAPP_VERIFY_TOKEN value you set below
#      and subscribe to the "messages" webhook field.
#
# Permanent System-User access token.
WHATSAPP_ACCESS_TOKEN=
# The sending number's Phone number ID from API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you invent; must match the webhook config screen.
WHATSAPP_VERIFY_TOKEN=
# STRONGLY RECOMMENDED: the app's App Secret (App Settings → Basic).
# Enables signature verification so nobody can forge inbound webhooks.
WHATSAPP_APP_SECRET=
# Optional overrides (sensible defaults used if left blank):
#   WHATSAPP_API_VERSION           default: v21.0
#   WHATSAPP_DEFAULT_COUNTRY_CODE  default: 94 — used to normalize local
#                                  numbers like 0771234567 when automations
#                                  message leads on WhatsApp
#   OPENAI_WHATSAPP_MODEL          default: OPENAI_CHAT_MODEL — the model
#                                  behind the WhatsApp sales agent
WHATSAPP_API_VERSION=
WHATSAPP_DEFAULT_COUNTRY_CODE=
OPENAI_WHATSAPP_MODEL=

# ---- App ------------------------------------------------------
# Public base URL used to build invite + booking links.
# Local dev: http://localhost:3000  |  Prod: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email address of the workspace owner / first admin.
# The user who signs up with this email is auto-promoted to admin.
NEXT_PUBLIC_ADMIN_EMAIL=arc.ai.agencylk@gmail.com

# --- ElevenLabs (0104): the JARVIS voice --------------------------------
# When set, every spoken line (replies, the greeting, "Yes, sir?", ambient
# alerts) uses ElevenLabs; any failure falls back to OpenAI TTS in the same
# request. Voice defaults to "Daniel — Steady Broadcaster" (British).
# Alternatives: George JBFqnCBsd6RMkjVDRZzb (warmer British), or any cloned
# voice id from your ElevenLabs account.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ---------------------------------------------------------------------------
# WEB ANALYTICS — www.arcai.agency  (migration 0105)
# ---------------------------------------------------------------------------
# The website is a separate Next.js app in a SEPARATE Supabase project. The
# Web Analytics page mirrors that project's visitor analytics and AI-agent
# transcripts into this one, because you cannot join across two Postgres
# projects and the dashboard needs website behaviour next to CRM leads.
#
# Find these in the WEBSITE's Supabase dashboard:
#   Project Settings -> API -> Project URL      -> WEBSITE_SUPABASE_URL
#   Project Settings -> API -> service_role key -> WEBSITE_SUPABASE_SERVICE_ROLE_KEY
#
# The service-role key bypasses RLS on the website project. Everything in
# @/lib/web-analytics only ever reads with it — but treat it as a full
# credential to that database and keep it out of version control.
#
# Leave these unset and the whole feature is a clean no-op: the nav item is
# still there, the page explains what is missing, and the automation tick
# skips the pull entirely.
WEBSITE_SUPABASE_URL=
WEBSITE_SUPABASE_SERVICE_ROLE_KEY=
# Label written onto every mirrored row. Only change it if you point this at
# a different site — it is the key every query filters on.
WEBSITE_ANALYTICS_SITE=arcai.agency

# ---- AI Projects (0126) — the hosted website agent ---------------------------
# Uses OPENAI_API_KEY (chat + embeddings) and FIRECRAWL_API_KEY (site crawls).
# NEXT_PUBLIC_APP_URL must be the CRM's public origin: it is the host in the
# snippet clients embed and the origin the Deploy-tab preview is allowed from.
#   OPENAI_EMBED_MODEL   default: text-embedding-3-small (1536 dims — the
#                        ai_kb_chunks.embedding column is sized for it; a
#                        model with another width needs a new column).
#   AI_CHAT_BUDGET_MS    default: 30000 — wall-clock ceiling for one visitor
#                        turn, tools included. Stay under the platform's own.
OPENAI_EMBED_MODEL=
AI_CHAT_BUDGET_MS=

# ============================================================================
# 0129 — the rest of what the code actually reads
# ============================================================================
# Everything above predates this block; the 84 names the code reads had
# drifted from the 43 documented here, and the file itself was gitignored
# (.gitignore:34's `.env*`), so the manifest lived on one laptop. Both are
# fixed. Every var below is OPTIONAL — each has a default in code, and the
# feature it belongs to degrades cleanly when it is unset.
#
# Set by the platform, never by you: NODE_ENV, NETLIFY, URL.

# ---- Push notifications (web-push) ------------------------------------------
# Unset = the bell still works in-app; only browser push is skipped.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Social publishing (0118) -----------------------------------------------
#   SOCIAL_TOKEN_KEY  encrypts stored account tokens. connectSocialAccount()
#                     REFUSES to write without it — set it before connecting.
#   SOCIAL_DRY_RUN=1  runs the whole publish queue without calling Meta.
SOCIAL_TOKEN_KEY=
SOCIAL_DRY_RUN=

# ---- Error tracking (0121) --------------------------------------------------
# Unset = errors are still recorded in error_events and shown on /settings;
# only the Sentry envelope is skipped.
SENTRY_DSN=

# ---- Model choices per surface ----------------------------------------------
# Each defaults to the general chat model. Override one to move a single
# surface without touching the others. See src/lib/ai/reasoning-core.ts for
# why effort and function tools cannot both be sent to gpt-5.4+.
OPENAI_BASE_URL=
OPENAI_BRIEFING_MODEL=
OPENAI_MEMORY_MODEL=
OPENAI_MISSION_MODEL=
OPENAI_PLANNER_MODEL=
OPENAI_NOTICE_MODEL=
OPENAI_NOTICE_TIMEOUT_MS=
OPENAI_OUTREACH_MODEL=
OPENAI_OUTREACH_REASONING_EFFORT=
OPENAI_OUTREACH_TIMEOUT_MS=
OPENAI_INSIGHTS_MODEL=
OPENAI_INSIGHTS_EFFORT=
OPENAI_VISION_MODEL=
OPENAI_CHAT_TIMEOUT_MS=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
RESEARCH_BG_SYNTH=

# ---- Content Office (0130) --------------------------------------------------
# Each agent has a model chain in code (src/lib/agents/roster.ts); an override
# here goes to the FRONT of that chain and the code's models stay as fallbacks.
# The Director is gpt-6-astra by default — tool calling on it needs the
# Responses API, which is what the office uses for every agent call.
OPENAI_AGENT_MANAGER_MODEL=
OPENAI_AGENT_RESEARCH_MODEL=
OPENAI_AGENT_PLANNER_MODEL=
OPENAI_AGENT_WRITER_MODEL=
OPENAI_AGENT_DESIGNER_MODEL=
OPENAI_AGENT_BRAND_MODEL=
OPENAI_AGENT_QA_MODEL=
OPENAI_AGENT_PUBLISHER_MODEL=
# Hard stop on paid agent calls per Colombo day, USD. Also editable by an
# admin on the Office page (app_settings.content_office). Default 15.
OFFICE_DAILY_BUDGET_USD=
# The contentOffice pass's own budget inside the 5-minute tick (ms). Default 6000.
OFFICE_TICK_BUDGET_MS=
# OpenAI's built-in web search tool type: web_search (default) or
# web_search_preview. The runtime retries once with the preview name.
OPENAI_WEB_SEARCH_TOOL=
# What one web search call is booked at, USD (list price $10 per 1k). 0.01.
OPENAI_WEB_SEARCH_PER_CALL_USD=

# ---- Voice (ElevenLabs) -----------------------------------------------------
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
GEMINI_IMAGE_TIMEOUT_MS=

# ---- Tick budgets -----------------------------------------------------------
# The automation tick walks a ring of passes under a start budget so the
# platform cannot kill it mid-pass. Raise only with the platform's own
# function timeout in mind.
#   TICK_BUDGET_MS             default 8000
#   OUTREACH_TICK_BUDGET_MS    the outreach pass's own inner cap
#   WA_AGENT_RUNS_PER_TICK     WhatsApp agent replies per minute-tick
#   WEB_ANALYTICS_STEP_MS      one bounded step of the analytics job
#   WEB_ANALYTICS_SYNC_INTERVAL_HOURS  default 12 (twice daily)
TICK_BUDGET_MS=
OUTREACH_TICK_BUDGET_MS=
WA_AGENT_RUNS_PER_TICK=
WEB_ANALYTICS_STEP_MS=
WEB_ANALYTICS_SYNC_INTERVAL_HOURS=

# ---- Inbound webhooks and outbound links ------------------------------------
#   RESEND_WEBHOOK_SECRET        verifies Resend delivery/bounce/open callbacks
#   OUTREACH_UNSUBSCRIBE_SECRET  signs one-click unsubscribe links
#   TEAM_ALERT_PHONE             where "a human is needed" SMS alerts land
#   WEBSITE_PUBLIC_URL           the marketing site's public origin
RESEND_WEBHOOK_SECRET=
OUTREACH_UNSUBSCRIBE_SECRET=
TEAM_ALERT_PHONE=
WEBSITE_PUBLIC_URL=

# ---- The client-kit read API (0127) -----------------------------------------
# Used by the generated client kit to call back into the CRM.
ARC_AI_BASE=
ARC_AI_READ_KEY=
ARC_AI_SECRET=
